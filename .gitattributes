# Force LF line endings for all text files
* text=auto eol=lf

# Explicitly mark text files
*.py text eol=lf
*.md text eol=lf
*.txt text eol=lf
*.sh text eol=lf
*.ini text eol=lf
*.json text eol=lf
*.yaml text eol=lf
*.yml text eol=lf
*.html text eol=lf
*.css text eol=lf
*.js text eol=lf

# Binary files (no conversion)
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.ico binary
*.pdf binary
*.pkl binary
*.npy binary
*.npz binary
